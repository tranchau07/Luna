{
  "name": "luna-3d-world-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Modular ambient 3D nature world kit built with Vite, TypeScript, and Three.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"scripts/**/*.mjs\" index.html",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "alea": "^1.0.1",
    "camera-controls": "^3.1.2",
    "postprocessing": "^6.39.6",
    "simplex-noise": "^4.0.3",
    "three": "~0.187.0",
    "three-custom-shader-material": "^6.4.0",
    "three-mesh-bvh": "^0.9.18",
    "three.quarks": "^0.17.1",
    "yuka": "^0.7.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/three": "~0.187.0",
    "@types/yuka": "^0.7.4",
    "eslint": "^9.39.1",
    "lil-gui": "^0.21.0",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "stats-gl": "^4.2.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
